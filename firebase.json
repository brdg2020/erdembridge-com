{
  "hosting": {
    "site": "erdembridge-com",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "/pdf/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/briç-malzemeleri",
        "destination": "/hakkimda",
        "type": 301
      },
      {
        "source": "/bri%C3%A7-malzemeleri",
        "destination": "/hakkimda",
        "type": 301
      },
      {
        "source": "/bric-kursu",
        "destination": "/birebir-bric-kursu",
        "type": 301
      },
      {
        "source": "/anasayfa",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/briç-nedir",
        "destination": "/hakkimda",
        "type": 301
      },
      {
        "source": "/bri%C3%A7-nedir",
        "destination": "/hakkimda",
        "type": 301
      },
      {
        "source": "/briç-dersleri/:path*",
        "destination": "/ozel-bric-dersleri",
        "type": 301
      },
      {
        "source": "/bri%C3%A7-dersleri/:path*",
        "destination": "/ozel-bric-dersleri",
        "type": 301
      },
      {
        "source": "/briç-nasıl-oynanır/:path*",
        "destination": "/ozel-bric-dersleri",
        "type": 301
      },
      {
        "source": "/bri%C3%A7-nas%C4%B1l-oynan%C4%B1r/:path*",
        "destination": "/ozel-bric-dersleri",
        "type": 301
      },
      {
        "source": "/briç-öğren/:path*",
        "destination": "/ozel-bric-dersleri",
        "type": 301
      },
      {
        "source": "/bri%C3%A7-%C3%B6%C4%9Fren/:path*",
        "destination": "/ozel-bric-dersleri",
        "type": 301
      },
      {
        "source": "/bric-puan-hesaplama-ve-skor",
        "destination": "/ozel-bric-dersleri",
        "type": 301
      },
      {
        "source": "/bric-bbo-online-oyun-rehberi",
        "destination": "/online-bric-koclugu",
        "type": 301
      },
      {
        "source": "/posts/:path*",
        "destination": "/",
        "type": 301
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}